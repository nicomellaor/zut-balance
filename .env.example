# Private hostname served by Caddy. Use a DNS name or IP reachable on your LAN.
ZUT_BALANCE_HOST=localhost
ZUT_BALANCE_HTTPS_PORT=8443
ZUT_BALANCE_TRUSTED_ORIGINS=https://localhost:8443

# Generate each value with: python scripts/generate_secrets.py <kind>. Keep the
# single quotes around the generated hash so Docker Compose preserves dollar signs.
ZUT_BALANCE_ADMIN_PASSWORD_HASH=replace-with-generated-argon2-hash
ZUT_BALANCE_SESSION_SECRET=replace-with-generated-session-secret-at-least-32-characters
ZUT_BALANCE_API_KEY=replace-with-generated-integration-api-key
